MERGE (n:KGNode {id: "tech:gat"}) SET n += {id: "tech:gat", label: "图注意力网络 (GAT)", type: "AI/graph model", layer: "model", position: "技术层/spatial relations", summary: "图神经网络的一种，通过注意力权重学习哪些邻居或关系更重要，适合解释不同证据对靶区的贡献。", url: ""};

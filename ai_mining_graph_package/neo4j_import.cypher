// Neo4j import script for AI+探矿知识图谱
CREATE CONSTRAINT kg_node_id IF NOT EXISTS FOR (n:KGNode) REQUIRE n.id IS UNIQUE;

MERGE (n:KGNode {id: "tech:machine_learning"}) SET n += {id: "tech:machine_learning", label: "机器学习", type: "AI/model family", layer: "model", position: "技术层/modeling", summary: "从历史矿床、地球化学、地球物理、遥感等样本中学习规律，用于预测未知区域的成矿潜力。", url: ""};
MERGE (n:KGNode {id: "tech:deep_learning"}) SET n += {id: "tech:deep_learning", label: "深度学习", type: "AI/model family", layer: "model", position: "技术层/modeling", summary: "用多层神经网络自动学习复杂特征，适合影像、岩心、地球物理反演和非线性空间模式。", url: ""};
MERGE (n:KGNode {id: "tech:supervised_learning"}) SET n += {id: "tech:supervised_learning", label: "监督学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:semi_supervised_learning"}) SET n += {id: "tech:semi_supervised_learning", label: "半监督学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:self_supervised_learning"}) SET n += {id: "tech:self_supervised_learning", label: "自监督学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:unsupervised_learning"}) SET n += {id: "tech:unsupervised_learning", label: "无监督学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:transfer_learning"}) SET n += {id: "tech:transfer_learning", label: "迁移学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:active_learning"}) SET n += {id: "tech:active_learning", label: "主动学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:few_shot_learning"}) SET n += {id: "tech:few_shot_learning", label: "小样本学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:ensemble_learning"}) SET n += {id: "tech:ensemble_learning", label: "集成学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:federated_learning"}) SET n += {id: "tech:federated_learning", label: "联邦学习", type: "AI/paradigm", layer: "model", position: "技术层/learning paradigm", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:random_forest"}) SET n += {id: "tech:random_forest", label: "随机森林 (Random Forest)", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "由许多决策树组成的集成模型。探矿里常用来融合多种证据层，优点是稳健、能处理非线性、可输出变量重要性。", url: ""};
MERGE (n:KGNode {id: "tech:decision_tree"}) SET n += {id: "tech:decision_tree", label: "决策树", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:gradient_boosting"}) SET n += {id: "tech:gradient_boosting", label: "梯度提升", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:xgboost"}) SET n += {id: "tech:xgboost", label: "XGBoost", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "高性能梯度提升树模型，适合结构化地学因子和小中型样本，经常用于 MPM 和靶区排序。", url: ""};
MERGE (n:KGNode {id: "tech:lightgbm"}) SET n += {id: "tech:lightgbm", label: "LightGBM", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:catboost"}) SET n += {id: "tech:catboost", label: "CatBoost", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:svm"}) SET n += {id: "tech:svm", label: "支持向量机 (SVM)", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "通过寻找分类边界区分成矿/非成矿样本。样本较少时常见，但参数和核函数选择会影响外推能力。", url: ""};
MERGE (n:KGNode {id: "tech:knn"}) SET n += {id: "tech:knn", label: "k 近邻 (KNN)", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:logistic_regression"}) SET n += {id: "tech:logistic_regression", label: "逻辑回归", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:naive_bayes"}) SET n += {id: "tech:naive_bayes", label: "朴素贝叶斯", type: "AI/classical model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:bayesian_network"}) SET n += {id: "tech:bayesian_network", label: "贝叶斯网络", type: "AI/probabilistic model", layer: "model", position: "技术层/uncertainty", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:gaussian_process"}) SET n += {id: "tech:gaussian_process", label: "高斯过程", type: "AI/probabilistic model", layer: "model", position: "技术层/uncertainty", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:markov_random_field"}) SET n += {id: "tech:markov_random_field", label: "马尔可夫随机场", type: "AI/probabilistic model", layer: "model", position: "技术层/spatial model", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:mlp"}) SET n += {id: "tech:mlp", label: "多层感知机/人工神经网络 (MLP/ANN)", type: "AI/neural model", layer: "model", position: "技术层/modeling", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:cnn"}) SET n += {id: "tech:cnn", label: "卷积神经网络 (CNN)", type: "AI/deep model", layer: "model", position: "技术层/spatial/deep learning", summary: "擅长识别局部空间纹理和图像特征，在遥感蚀变识别、岩性分类、岩心图像和地球物理网格解释中常用。", url: ""};
MERGE (n:KGNode {id: "tech:rnn_lstm_gru"}) SET n += {id: "tech:rnn_lstm_gru", label: "循环神经网络/LSTM/GRU", type: "AI/deep model", layer: "model", position: "技术层/sequence learning", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:autoencoder"}) SET n += {id: "tech:autoencoder", label: "自编码器", type: "AI/deep model", layer: "model", position: "技术层/representation learning", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:vae"}) SET n += {id: "tech:vae", label: "变分自编码器 (VAE)", type: "AI/generative model", layer: "model", position: "技术层/generative learning", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:gan"}) SET n += {id: "tech:gan", label: "生成对抗网络 (GAN)", type: "AI/generative model", layer: "model", position: "技术层/generative learning", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:diffusion_model"}) SET n += {id: "tech:diffusion_model", label: "扩散模型", type: "AI/generative model", layer: "model", position: "技术层/generative learning", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:transformer"}) SET n += {id: "tech:transformer", label: "Transformer", type: "AI/foundation model", layer: "model", position: "技术层/foundation model", summary: "基于注意力机制的深度模型，可处理长距离依赖；在遥感、高光谱、地学基础模型和文本报告理解中越来越重要。", url: ""};
MERGE (n:KGNode {id: "tech:vision_transformer"}) SET n += {id: "tech:vision_transformer", label: "视觉 Transformer (ViT)", type: "AI/foundation model", layer: "model", position: "技术层/remote sensing", summary: "这是 AI+探矿中的技术/模型节点，点击相关关系可以看到它常连接的数据、任务或论文证据。", url: ""};
MERGE (n:KGNode {id: "tech:foundation_model"}) SET n += {id: "tech:foundation_model", label: "地学/地理空间基础模型", type: "AI/foundation model", layer: "model", position: "技术层/foundation model", summary: "在大规模地学、遥感或地球物理数据上预训练的通用模型，再迁移到特定矿种、区域或任务。", url: ""};
MERGE (n:KGNode {id: "tech:llm"}) SET n += {id: "tech:llm", label: "大语言模型 (LLM)", type: "AI/foundation model", layer: "model", position: "技术层/knowledge interface", summary: "用于理解论文、地质报告、矿权资料和专家描述，可配合知识图谱形成问答、证据追溯和假设生成系统。", url: ""};
MERGE (n:KGNode {id: "tech:rag"}) SET n += {id: "tech:rag", label: "检索增强生成 (RAG)", type: "AI/system pattern", layer: "model", position: "技术层/knowledge interface", summary: "先从论文/报告/数据库检索相关证据，再让大模型生成答案，减少凭空生成，适合项目尽调和地质证据查询。", url: ""};
MERGE (n:KGNode {id: "tech:knowledge_graph"}) SET n += {id: "tech:knowledge_graph", label: "知识图谱", type: "AI/knowledge representation", layer: "model", position: "技术层/knowledge layer", summary: "把矿床、构造、岩性、异常、方法、论文、公司等实体和关系结构化，支撑检索、推理和可解释展示。", url: ""};
MERGE (n:KGNode {id: "tech:gnn"}) SET n += {id: "tech:gnn", label: "图神经网络 (GNN)", type: "AI/graph model", layer: "model", position: "技术层/spatial relations", summary: "把地质单元、矿点、构造、异常等作为图节点，用边表达空间邻近或成因关系，适合建模传统网格难表达的地质关联。", url: ""};
